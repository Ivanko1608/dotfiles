{
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Google_Drive__create_file"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/user/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/caveman-statusline.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "tinfoil@tinfoil": true,
    "superpowers@claude-plugins-official": true,
    "understand-anything@understand-anything": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "skins@hellosverre-mods": true,
    "savvy-progress@claude-kit": true,
    "savvy-flow@claude-kit": true,
    "claude-reflect@claude-reflect-marketplace": true,
    "cache-tax@claude-code-mods": true,
    "blast-radius@claude-code-playground-mods": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "tinfoil": {
      "source": {
        "source": "github",
        "repo": "Ivanko1608/tinfoil"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "claude-code-filetree": {
      "source": {
        "source": "github",
        "repo": "data-goblin/claude-code-filetree"
      }
    },
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "johnnyvizz/claude-kit"
      }
    },
    "hellosverre-mods": {
      "source": {
        "source": "github",
        "repo": "hellosverre/claude-skins"
      }
    },
    "claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "karanb192/claude-code-mods"
      }
    },
    "claude-reflect-marketplace": {
      "source": {
        "source": "github",
        "repo": "bayramannakov/claude-reflect"
      }
    },
    "claude-code-playground-mods": {
      "source": {
        "source": "directory",
        "path": "/home/user/.claude/mods/claude-code-playground/claude-code/mods"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 200000,
  "pluginConfigs": {
    "savvy-progress@claude-kit": {
      "options": {
        "language": "auto",
        "autoOpen": "savvy"
      }
    }
  },
  "tui": "fullscreen",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
