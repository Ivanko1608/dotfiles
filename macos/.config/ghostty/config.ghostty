# Ghostty (macOS). Colors come from the include below, generated by theme-set;
# includes load after this file, so the theme wins for colors only.
config-file = ?~/.local/state/omarchy-macos/theme/ghostty.conf

font-family = JetBrainsMonoNL Nerd Font
font-size = 14

# Left Option = Meta for zsh/nvim (Alt+b, Alt+., Alt+d, LazyVim Alt+j/k).
# Right Option stays a normal Option key, so dead-key accents (á ñ ü) still
# type in the terminal. AeroSpace grabs its alt-* bindings before Ghostty
# sees them, and it can't tell left from right, so those fire from either.
macos-option-as-alt = left

macos-titlebar-style = hidden
window-padding-x = 6
window-padding-y = 4
window-padding-balance = true

# AeroSpace launches a new instance per Super+Return; don't leave idle ones.
quit-after-last-window-closed = true

# Same as the Alacritty config: Shift+Enter as CSI-u (Claude Code newline).
keybind = shift+enter=text:\x1b[13;2u
