#!/usr/bin/env bash
# theme-set [<name>] [--no-reload]
#
# Switch SketchyBar, JankyBorders, Ghostty and starship to a theme in one go.
# A theme is one directory holding an Omarchy-format colors.toml:
#   ~/.config/omarchy-macos/themes/<name>/colors.toml
# Generated files go to ~/.local/state/omarchy-macos/theme/, which each tool's
# config includes. AeroSpace has no colors, so it is untouched.
# With no name, lists themes (* marks the current one).
set -euo pipefail

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-macos"
themes="$cfg/themes"
state="$HOME/.local/state/omarchy-macos"
out="$state/theme"

list_themes() {
	local current d n
	current="$(cat "$out/name" 2>/dev/null || true)"
	for d in "$themes"/*/; do
		n="$(basename "$d")"
		[ -r "$d/colors.toml" ] || continue
		if [ "$n" = "$current" ]; then echo "* $n"; else echo "  $n"; fi
	done
}

if [ $# -eq 0 ]; then
	list_themes
	exit 0
fi

name="$1"
reload=1
[ "${2:-}" = "--no-reload" ] && reload=0

colors="$themes/$name/colors.toml"
if [ ! -r "$colors" ]; then
	echo "theme-set: no theme '$name'. Available:" >&2
	list_themes >&2
	exit 1
fi

# color KEY [FALLBACK_KEY]: print the "#rrggbb" value of KEY from colors.toml.
color() {
	local v
	v="$(awk -F= -v k="$1" '
		{ key = $1; gsub(/[ \t]/, "", key) }
		key == k { v = $2; gsub(/[ \t"]/, "", v); print tolower(v); exit }
	' "$colors")"
	if [ -z "$v" ] && [ -n "${2:-}" ]; then
		v="$(color "$2")"
	fi
	if [ -z "$v" ]; then
		echo "theme-set: theme '$name' has no '$1' color" >&2
		return 1
	fi
	printf '%s' "$v"
}

# argb "#rrggbb" -> 0xffrrggbb (SketchyBar / JankyBorders format)
argb() { printf '0xff%s' "${1#\#}"; }

background="$(color background)"
foreground="$(color foreground)"
dark_foreground="$(color dark_foreground muted)"
bright_foreground="$(color bright_foreground foreground)"
accent="$(color accent blue)"
muted="$(color muted)"
selection_background="$(color selection_background selection)"
selection_foreground="$(color selection_foreground bright_foreground)"
red="$(color red)"
green="$(color green)"
yellow="$(color yellow)"
blue="$(color blue)"
magenta="$(color magenta)"
cyan="$(color cyan)"
bright_red="$(color bright_red red)"
bright_green="$(color bright_green green)"
bright_yellow="$(color bright_yellow yellow)"
bright_blue="$(color bright_blue blue)"
bright_magenta="$(color bright_magenta magenta)"
bright_cyan="$(color bright_cyan cyan)"

tmp="$(mktemp -d "${TMPDIR:-/tmp}/theme-set.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

echo "$name" >"$tmp/name"

cat >"$tmp/sketchybar.sh" <<EOF
# Generated by theme-set ($name). Do not edit.
BAR_COLOR=$(argb "$background")
FG_COLOR=$(argb "$foreground")
MUTED_COLOR=$(argb "$dark_foreground")
ACCENT_COLOR=$(argb "$accent")
ON_ACCENT_COLOR=$(argb "$background")
EOF

cat >"$tmp/borders.sh" <<EOF
# Generated by theme-set ($name). Do not edit.
ACTIVE_COLOR=$(argb "$accent")
INACTIVE_COLOR=0x00000000
EOF

# Same mapping as Omarchy's default/themed/ghostty.conf.tpl.
cat >"$tmp/ghostty.conf" <<EOF
# Generated by theme-set ($name). Do not edit.
background = $background
foreground = $foreground
cursor-color = $bright_foreground
selection-background = $selection_background
selection-foreground = $selection_foreground
palette = 0=$background
palette = 1=$red
palette = 2=$green
palette = 3=$yellow
palette = 4=$blue
palette = 5=$magenta
palette = 6=$cyan
palette = 7=$foreground
palette = 8=$muted
palette = 9=$bright_red
palette = 10=$bright_green
palette = 11=$bright_yellow
palette = 12=$bright_blue
palette = 13=$bright_magenta
palette = 14=$bright_cyan
palette = 15=$bright_foreground
EOF

base="$cfg/starship-base.toml"
if [ -r "$base" ]; then
	{
		sed '/^# --- palette (replaced by theme-set) ---$/,$d' "$base"
		echo "# --- palette (generated by theme-set: $name) ---"
		echo "[palettes.omarchy]"
		echo "accent = \"$accent\""
	} >"$tmp/starship.toml"
fi

mkdir -p "$state"
rm -rf "$out.old"
[ -d "$out" ] && mv "$out" "$out.old"
mv "$tmp" "$out"
rm -rf "$out.old"
trap - EXIT

if [ "$reload" = 1 ]; then
	if pgrep -x sketchybar >/dev/null 2>&1; then
		sketchybar --reload
	fi
	# Running bordersrc while borders is up updates the running instance.
	if pgrep -x borders >/dev/null 2>&1; then
		"${XDG_CONFIG_HOME:-$HOME/.config}/borders/bordersrc"
	fi
	# Ghostty reloads its config on SIGUSR2. starship reads its config per prompt.
	pkill -USR2 -x ghostty 2>/dev/null || true
fi

echo "theme: $name"
